# Keep scripts runnable regardless of the contributor's core.autocrlf setting.
*.sh   text eol=lf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.rs   text eol=lf
*.wgsl text eol=lf
*.py   text eol=lf
*.dff  binary
*.rgba binary
*.res  binary
*.ico  binary
*.png  binary
*.ifp  binary
*.ttf  binary
*.db   binary
target/** filter=lfs diff=lfs merge=lfs -text
